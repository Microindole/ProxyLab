# Never commit the populated .env file.
LAB_ROLE=server
LAB_DATA_ROOT=/var/lib/proxy-traffic-lab
LAB_LOG_LEVEL=INFO

# Optional remote VPS diagnostics. Prefer SSH keys; do not store passwords here.
LAB_VPS_HOST=
LAB_VPS_SSH_USER=root
LAB_VPS_SSH_PORT=22
LAB_VPS_IDENTITY_FILE=

# Public endpoint values are deliberately not committed.
LAB_PROXY_SERVER_HOST=
LAB_ALLOWED_CLIENT_CIDR=

# Conservative defaults for a 2-core / 4-GiB host.
LAB_MAX_EXPERIMENT_SECONDS=300
LAB_MAX_CAPTURE_BYTES=536870912
LAB_MAX_CONNECTIONS=32
LAB_MAX_BANDWIDTH_MBPS=10
LAB_MIN_FREE_DISK_GIB=10

